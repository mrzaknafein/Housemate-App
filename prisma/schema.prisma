generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Room {
  id           String          @id @default(cuid())
  code         String          @unique // 6-digit format e.g. HM-4829
  name         String          // e.g. "Moda Evimiz" or "302 Nolu Yurt Odası"
  type         String          @default("HOUSE") // "HOUSE" | "DORM"
  cycleDay     Int             @default(1) // 1 to 28
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  members      Member[]
  categories   Category[]
  periods      BillingPeriod[]
  expenses     Expense[]
}

model Member {
  id             String                @id @default(cuid())
  roomId         String
  name           String
  token          String                @unique
  avatarColor    String                @default("#cd853f")
  joinedAt       DateTime              @default(now())
  room           Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  expensesPaid   Expense[]             @relation("PaidByMember")
  categorySplits CategorySplit[]
  periodSplits   PeriodCategorySplit[]

  @@index([roomId])
}

model Category {
  id             String                @id @default(cuid())
  roomId         String
  name           String                // e.g. "Kira", "Elektrik", "Damacana Su"
  icon           String                @default("Receipt")
  isDefault      Boolean               @default(false)
  hasCustomSplit Boolean               @default(false)
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  room           Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  splits         CategorySplit[]
  periodSplits   PeriodCategorySplit[]

  @@unique([roomId, name])
  @@index([roomId])
}

model CategorySplit {
  id         String   @id @default(cuid())
  categoryId String
  memberId   String
  percentage Float    // 0 to 100
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([categoryId, memberId])
  @@index([categoryId])
}

model BillingPeriod {
  id           String                @id @default(cuid())
  roomId       String
  periodKey    String                // e.g. "2026-10" (sorted chronologically)
  label        String                // e.g. "15 Ekim - 14 Kasım 2026"
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean               @default(false)
  isFrozen     Boolean               @default(false) // Historical periods keep frozen split snapshots
  createdAt    DateTime              @default(now())
  room         Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  expenses     Expense[]
  periodSplits PeriodCategorySplit[]

  @@unique([roomId, periodKey])
  @@index([roomId, periodKey])
}

model PeriodCategorySplit {
  id         String        @id @default(cuid())
  periodId   String
  categoryId String
  memberId   String
  percentage Float
  isZeroConfirmed Boolean  @default(false) // false = if 0 TL in active period, treat as "Fatura Bekleniyor" (do not drop chart to 0); true = explicitly confirmed 0 TL
  period     BillingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  member     Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([periodId, categoryId, memberId])
  @@index([periodId, categoryId])
}

model Expense {
  id           String        @id @default(cuid())
  roomId       String
  periodId     String
  categoryId   String
  paidById     String
  amount       Float
  title        String        // Optional sub-note e.g. "19L Erikli Su" or "Ekim Elektrik Faturası"
  expenseDate  DateTime      @default(now())
  createdAt    DateTime      @default(now())
  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  period       BillingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  paidBy       Member        @relation("PaidByMember", fields: [paidById], references: [id], onDelete: Cascade)

  @@index([roomId, periodId])
  @@index([categoryId, periodId])
}
